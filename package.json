    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@bytecodealliance/componentize-js": "0.19.3",
    "@bytecodealliance/jco": "1.17.9",
    "cross-spawn": "7.0.6",
    "esbuild": "0.28.2",
    "semver": "7.8.5",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24",
    "@types/semver": "^7.7.1",
    "hono": "^4.6.0",
    "typescript": "^5.9.3"
  }
}
