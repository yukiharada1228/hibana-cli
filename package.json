{
  "name": "@yukiharada1228/hibana",
  "version": "0.4.0-rc.2",
  "description": "TypeScript CLI for Hibana applications",
  "type": "module",
  "bin": {
    "hibana": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiharada1228/hibana-cli.git"
  },
  "homepage": "https://github.com/yukiharada1228/hibana-cli",
  "bugs": {
    "url": "https://github.com/yukiharada1228/hibana-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist/",
    "templates/",
    "wit/",
    "assets/",
    "licenses/",
    "THIRD_PARTY_LICENSES.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
